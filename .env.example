# ============================================================
# MDM Pilot — environment configuration
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and must NEVER be committed.
# ============================================================

# --- Gemini (AI screening) ---
# Your working AI Studio key (the "AQ." prefixed one). Used by the AI module.
GEMINI_API_KEY=AQ.your_key_here
GEMINI_MODEL=gemini-3.6-flash

# --- Google service account (Phase 0 output) ---
# The ENTIRE contents of the downloaded service-account JSON, on one line.
# In local dev you can instead point to the file with GOOGLE_APPLICATION_CREDENTIALS.
# In Vercel, paste the JSON string into this env var.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Local-only alternative to the above (path to the .json key file):
GOOGLE_APPLICATION_CREDENTIALS=./keys/mdm-backend.json

# --- Google resource IDs (Phase 0 output — fill when you have them) ---
DAILY_SHEET_ID=
BASELINE_SHEET_ID=
DAILY_DRIVE_FOLDER_ID=
BASELINE_DRIVE_FOLDER_ID=
# Tab name inside the response sheets (usually "Form Responses 1")
DAILY_SHEET_TAB=Form Responses 1
BASELINE_SHEET_TAB=Form Responses 1

# --- Results store (Phase 3) ---
# Sheet the backend WRITES processed results + reviewer verdicts back to.
RESULTS_SHEET_ID=
RESULTS_SHEET_TAB=Results

# --- Data source mode ---
# "sample" = read bundled fixtures (no Google access needed, for building/testing)
# "live"   = read real Google Sheets/Drive (needs Phase 0 done)
DATA_MODE=sample
